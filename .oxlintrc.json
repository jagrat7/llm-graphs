{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "jsPlugins": [
    {
      "name": "local",
      "specifier": "./dev/oxlint/index.mjs"
    }
  ],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "node_modules/**",
    ".output/**",
    ".tanstack/**",
    ".nitro/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".devin/**",
    ".impeccable/**",
    ".venv/**",
    "dist/**",
    "oldpythonref/**",
    "docs/launch-video-remotion/**",
    "public/**",
    "src/ui/components/ui/**",
    "src/ui/routeTree.gen.ts",
    "**/*.gen.ts"
  ],
  "rules": {
    "local/no-server-deep-imports": [
      "error",
      {
        "serverAlias": "#/server",
        "serverDirectory": "server"
      }
    ],
    "local/no-theme-variants": "error",
    "react/react-in-jsx-scope": "off",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase",
        "ignore": ["^routeTree\\.gen\\.ts$"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/server/services/**/index.ts", "src/server/services/**/index.tsx"],
      "rules": {
        "local/only-service-export": "error"
      }
    },
    {
      "files": ["src/ui/routes/**/*.{ts,tsx}"],
      "rules": {
        "local/no-server-deep-imports": "off"
      }
    },
    {
      "files": [
        "src/ui/design/page.tsx",
        "src/ui/design/tokens.ts",
        "src/ui/design/types.ts",
        "src/ui/design/demo.tsx",
        "src/ui/design/icons.tsx"
      ],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "unicorn/no-array-sort": "off"
      }
    },
    {
      "files": ["src/**/*.test.{ts,tsx}"],
      "rules": {
        "local/no-server-deep-imports": "off"
      }
    }
  ]
}
